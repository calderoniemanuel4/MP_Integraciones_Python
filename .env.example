ENVIRONMENT=development

MP_ACCESS_TOKEN=TEST-xxxxxxxx
MP_WEBHOOK_SECRET=xxxxxxxx
# Usar sandbox durante las pruebas; cambiar a production al habilitar cobros reales.
MP_CHECKOUT_MODE=sandbox

MP_SUCCESS_URL=https://mi-app.fastapicloud.com/checkout/success
MP_FAILURE_URL=https://mi-app.fastapicloud.com/checkout/failure
MP_PENDING_URL=https://mi-app.fastapicloud.com/checkout/pending
MP_WEBHOOK_URL=https://mi-app.fastapicloud.com/webhooks/mercadopago

GOOGLE_CLOUD_PROJECT=mi-proyecto-gcp
# FastAPI Cloud: guardar el JSON completo como secreto. Local: dejar vacío.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternativa solo local para usar un archivo fuera del repositorio.
GOOGLE_APPLICATION_CREDENTIALS=/ruta/segura/service_account.json
LOCAL_FRONTEND_ORIGIN=http://localhost:5500
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
